# ============================================================
# RushXO Production .env Template
# Copy this to .env on production server and fill in the values
# ============================================================

# ===== APP =====
APP_NAME=RushXO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/London
APP_URL=https://dashboard.rushxo.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ===== BRAND =====
APP_BRAND_PREFIX=rush
APP_BRAND_HIGHLIGHT=x
APP_BRAND_SUFFIX=o
APP_BRAND_LOGO=

# ===== LOGGING =====
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===== DATABASE =====
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u562106935_rushxo_taxi
DB_USERNAME=u562106935_rushxo
DB_PASSWORD=CHANGE_ME

# ===== SESSION =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=dashboard.rushxo.com

# ===== BROADCAST / QUEUE / CACHE =====
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=rushxo

# ===== REDIS (not used by default on Hostinger) =====
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== MAIL =====
# Option A: Gmail SMTP
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourname@gmail.com
# MAIL_PASSWORD=google-app-password
# MAIL_ENCRYPTION=tls

# Option B: Hostinger Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@rushxo.com
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=ssl

MAIL_FROM_ADDRESS=noreply@rushxo.com
MAIL_FROM_NAME="RushXO"

# ===== AWS S3 (optional - if using S3 for file uploads) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===== VITE =====
VITE_APP_NAME="${APP_NAME}"

# ===== TWILIO SMS (optional) =====
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== LARAVEL REVERB (WebSocket) =====
# Only fill if you set up Reverb server
REVERB_APP_ID=rushxo-taxi
REVERB_APP_KEY=CHANGE_ME_TO_RANDOM_STRING
REVERB_APP_SECRET=CHANGE_ME_TO_RANDOM_STRING
REVERB_HOST=dashboard.rushxo.com
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ===== GOOGLE MAPS =====
GOOGLE_MAPS_API_KEY=AIzaSyDIUh-CY5vcVjkqARo08YlFxJSUGAAMOb8

# ===== STRIPE =====
# Get keys from https://dashboard.stripe.com/apikeys
# Use pk_test_/sk_test_ for staging, pk_live_/sk_live_ for production
STRIPE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_SECRET=sk_test_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Register webhook at https://dashboard.stripe.com/webhooks
# Endpoint: https://dashboard.rushxo.com/webhooks/stripe
# Events: checkout.session.completed, payment_intent.payment_failed, charge.refunded
